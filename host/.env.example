# CES HOST — copy this file to host/.env and adjust for this machine.

# Shared database and server storage
CES_DATABASE_PATH=database/credit-entry.db
CRED_V6_DATA_DIR=host/credit-entry-host/server_data
CRED_V6_CLIENT_DATA_DIR=C:/client-data/credit-entry-data
CES_SWITCHBOARD_LOG_DIR=host/switchboard/logs

# Credit-entry API binding
CRED_V6_HOST=0.0.0.0
CRED_V6_PORT=8765
CRED_V6_ALLOWED_CASHIER_IPS=192.168.1.0/24,127.0.0.1,::1
CRED_V6_CLIENT_TOKEN=
CRED_V6_RELAY_TOKEN=
CRED_V6_ADMIN_TOKEN=

# SMS relay defaults
SMS_RELAY_SERVER_URL=http://127.0.0.1:8765
SMS_RELAY_ADB_PATH=adb
SMS_RELAY_POLL_INTERVAL_SECONDS=2
SMS_RELAY_TARGET_SENDERS=127,CBE,223,Awash Bank,BOA
SMS_RELAY_CONFIG_FILE=host/sms-relay-host/relay_config.json
SMS_RELAY_STATE_FILE=host/sms-relay-host/relay_state.json

# Maraki report receivers
MRK_RECEIVER_HOST=0.0.0.0
MRK_RECEIVER_PORT=8000
MRK_UPLOAD_DIR=host/mrk-host/received_packages
MRK_RETRO_RECEIVER_HOST=0.0.0.0
MRK_RETRO_RECEIVER_PORT=8001
MRK_RETRO_UPLOAD_DIR=host/mrk-host/retro_received_packages
