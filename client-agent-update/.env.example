# Copy to .env inside this folder and configure each client machine.
# Relative data paths resolve from this folder, regardless of launch location.
# Absolute defaults preserve existing client ledgers and reports.
CRED_V6_SERVER_URL=http://192.168.1.2:8765
CRED_V6_CLIENT_TOKEN=
CRED_V6_CLIENT_DATA_DIR=C:/client-data/credit-entry-data

# Reports served on this client PC. Change only if Maraki runs on another machine.
MRK_BASE_URL=http://127.0.0.1/MarakiReports2012
MRK_USERNAME=
MRK_PASSWORD=
MRK_DATA_DIR=C:/Client-data/mrk-data
MRK_RETRO_STATE_FILE=C:/Client-data/mrk-data/retro_state.json
MRK_RETRO_DATA_DIR=C:/Client-data/mrk-data
# Optional directory containing transaction XML files for timestamp correction.
MRK_XML_DIR=
# {id}: variable reference text; {ref_note}: complete reference; *: any suffix.
MRK_REF_NOTE_FORMAT=PAY-{id}
MRK_XML_FILENAME_PATTERN=P{ref_note}-*-*.xml
# Host PC: receives heartbeats and packages; this is not the client address.
MRK_RECEIVER_HOST=192.168.1.2
MRK_RECEIVER_PORT=8000
MRK_CONTROL_CLIENT_TOKEN=
MRK_CLIENT_NAME=
# Optional unique site ID; leave blank to generate a separate ID per PC.
MRK_CLIENT_ID=
MRK_AGENT_POLL_SECONDS=10
MRK_AGENT_STATE_DIR=mrk-agent-data
MRK_RETRO_RECEIVER_HOST=192.168.1.2
MRK_RETRO_RECEIVER_PORT=8001
